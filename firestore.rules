rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (isSignedIn() && (
        request.auth.token.email == 'codiagrooscar@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Trainings Collection
    match /trainings/{trainingId} {
      allow read, write: if true;
    }

    match /training_actions/{trainingId} {
      allow read, write: if true;
    }

    // Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read, write: if true;
    }

    // Followups Collection
    match /followups/{followupId} {
      allow read, write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /company_settings/{settingId} {
      allow read, write: if true;
    }
    
    // Metadata/Status Collections
    match /app_meta/{metaId} {
      allow read, write: if true;
    }
  }
}
