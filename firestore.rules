rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (isSignedIn() && (
        request.auth.token.email == 'codiagrooscar@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Trainings Collection
    match /trainings/{trainingId} {
      allow read: if true; // Public read so participants can load course details when submitting evaluation
      allow create, update, delete: if true; // In development/prototype allow seamless updates, protected in production
    }

    // Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read: if true;
      allow create: if true; // Allow participants to submit their completed questionnaire
      allow update, delete: if true;
    }

    // Followups Collection
    match /followups/{followupId} {
      allow read, write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
